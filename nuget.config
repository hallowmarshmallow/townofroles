<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- LocalPackages first: it holds a repacked ClassicUs.GameLibs (the nuget.org copy
         is malformed — backslash paths — so NuGet sees zero assets in it) and the rebuilt
         ClassicUs.ManuAPI 1.5.2 (stock nuget.org 1.5.1 crashes on Classic Us 8.9 — never
         substitute it). -->
    <add key="LocalPackages" value="./packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
